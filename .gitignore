# Runtime state and secrets — never commit these.
bot/state.json
bot/state.json.*
bot/freehands.log
bot/freehands.out
bot/freehands.pid
bot/freehands.stopped
# The supervisor publishes its bound port here; it is machine state, not source.
bot/console.port
# Logs can carry message text and tokens echoed from config.
bot/console.log
bot/waker.log
bot/.token
bot/token
.openhands/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

.DS_Store

# Android console app
app-android/.gradle/
app-android/build/
app-android/app/build/
app-android/local.properties
app-android/.idea/
*.apk
*.keystore
*.jks
# Signing material: the private key and the passwords beside it must never be
# committed. CI supplies the same values from repository secrets.
app-android/keystore.properties
keystore.properties
bot/events.jsonl
