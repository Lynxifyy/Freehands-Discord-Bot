    <path android:fillColor="#FFFFFF" android:pathData="M34,51 L66,51 L63,59 L31,59 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M40,64 L78,64 L75,72 L37,72 Z" />
</vector>
